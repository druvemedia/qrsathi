{
  "name": "qrsathi",
  "version": "1.0.0",
  "private": true,
  "description": "All-in-one smart QR code generator with UPI payments, dynamic QR, analytics and bulk generation.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-wasm.mjs && prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:demo": "node prisma/seed-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test:qr": "tsx scripts/test-qr.mts",
    "postinstall": "prisma generate && node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "test:barcodes": "tsx scripts/test-barcodes.mts",
    "test:api": "tsx scripts/test-api.mts",
    "test": "tsx scripts/test-qr.mts && tsx scripts/test-barcodes.mts",
    "test:browser": "tsx scripts/test-browser.mts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "nodemailer": "^10.2.1",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^5.8.8",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
