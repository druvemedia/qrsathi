# =====================================================================
# QRSathi configuration. Copy to `.env` and fill in. Placeholders only —
# never commit a real `.env`. The server validates these at startup and
# refuses to start in production if a required value is missing or unsafe.
# Anything named NEXT_PUBLIC_* is sent to every browser: never put secrets there.
# =====================================================================

# ---------- Required ----------

# Database. The provider is chosen from the URL scheme at build/migrate time
# (never switched at runtime):
#   Development (SQLite):  DATABASE_URL="file:./dev.db"
#   Production  (MySQL 8): DATABASE_URL="mysql://qrsathi:CHANGE_ME@db.internal:3306/qrsathi"
# See docs/DATABASE.md for setup and the SQLite → MySQL migration.
DATABASE_URL="file:./dev.db"

# Session-signing key: random, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Public origin (no trailing slash). Must be https:// in production. Used for
# password-reset links, the Google OAuth callback, CSRF origin checks and
# dynamic-QR short links — pick a domain you will keep long term.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Security ----------

# Key (32+ chars, different from AUTH_SECRET) that encrypts credentials entered in the
# admin console (e.g. Razorpay keys under Payment gateway). It must live only in the
# server environment — never in the database. Leave empty to disable database storage
# of credentials; use the RAZORPAY_* variables below instead.
SETTINGS_ENCRYPTION_KEY=""

# Separate key (32+ chars) for encrypting administrator TOTP secrets.
# Recommended in production so rotating AUTH_SECRET doesn't invalidate MFA.
MFA_ENCRYPTION_KEY=""

# Set only when the app runs behind a reverse proxy you control:
#   "true"       trust X-Real-IP / X-Forwarded-* from your proxy (nginx, Caddy, a load balancer)
#   "cloudflare" trust CF-Connecting-IP
# Leave empty when the app is exposed directly (headers are then ignored).
TRUST_PROXY=""

# Rate-limit counters: "memory" (single instance) or "database" (shared by all instances).
RATE_LIMIT_STORE="memory"

# Salt for hashing IP addresses in the audit log (optional; defaults to a key derived from AUTH_SECRET).
AUDIT_IP_SALT=""

# Logging: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=json|text (json is the production default).
LOG_LEVEL="info"
LOG_FORMAT=""

# ---------- Optional: Google sign-in ----------
# Authorised redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- E-mail (password reset, contact form) ----------
# Required in production on a public origin: the server refuses to start without SMTP_HOST
# unless MAIL_DISABLED="true" is set to run without e-mail on purpose.
# Without SMTP, reset links are printed to the server console in development only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="QRSathi <no-reply@example.com>"
MAIL_DISABLED=""

# ---------- Optional: billing (Razorpay Subscriptions) ----------
# Either set these (recommended for production; they take precedence), or enter them in
# the admin console under Payment gateway (needs SETTINGS_ENCRYPTION_KEY).
# The key prefix (rzp_test_ / rzp_live_) selects test or live mode.
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/billing/webhook — events: subscription.*,
# payment.failed, refund.processed. Plans change only after Razorpay confirms payment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Storage ----------
# Directory for uploaded files. Must be persistent, outside /public, and backed up.
UPLOAD_DIR="./uploads"

# ---------- Development only ----------
# "true" allows `npm run seed:demo` to create a labelled demo user with sample data.
# Ignored (always off) when NODE_ENV=production; the server refuses to start if set there.
DEMO_MODE="false"

# Production on a public origin refuses to start with SQLite. Set to "true" only if you
# deliberately run a single-server SQLite deployment (MySQL is the supported production database).
ALLOW_SQLITE_IN_PRODUCTION=""
# RAZORPAY_API_BASE exists only for the automated tests (Razorpay mock). A production
# server on a public origin refuses to start if it points anywhere but api.razorpay.com.

# Administrators are NOT configured here. Create the first super administrator on
# the server with:  npm run admin -- create --email you@company.com --super
# (ADMIN_EMAILS from older versions is ignored and should be removed.)
