# ---------- Required ----------
# SQLite for local dev. For production use Postgres (e.g. Supabase):
#   DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
#   and change provider to "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL. Dynamic QR codes encode short links on this domain, so it
# must be the domain you will keep long term.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated emails that become admins when they sign up / log in.
ADMIN_EMAILS="you@example.com"

# ---------- Optional: Google login ----------
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Optional: e-mail (password reset) ----------
# Without SMTP, reset links are printed to the server console in development only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="QRSathi <no-reply@example.com>"

# ---------- Optional: billing via Razorpay payment links ----------
# Plans are upgraded ONLY after a signature-verified webhook (payment_link.paid).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Storage ----------
# Directory for uploaded files (PDFs, images, documents). Must be outside /public.
UPLOAD_DIR="./uploads"

# ---------- Demo mode ----------
# When "true", `npm run seed:demo` may create a demo account with sample scans.
# Sample data is always labelled "Demo" in the UI. Never enable in production.
DEMO_MODE="false"
